<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qa.kb.persistence.TagMapper">

  <!-- 幂等插入：MySQL INSERT IGNORE。
       依赖 tags.name 唯一、page_tags 主键 (page_id, tag_id)（见 db/migration/V1__init.sql）。 -->
  <insert id="upsert">
    INSERT IGNORE INTO tags (name) VALUES (#{name})
  </insert>

  <insert id="attach">
    INSERT IGNORE INTO page_tags (page_id, tag_id) VALUES (#{pageId}, #{tagId})
  </insert>
</mapper>
